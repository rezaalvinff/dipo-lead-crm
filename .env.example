# ===== Wajib untuk mode live =====
# Postgres (Vercel → Storage → Neon akan mengisi ini otomatis)
DATABASE_URL=
# String acak min. 32 karakter: openssl rand -hex 32
AUTH_SECRET=
# Password akun "admin" pertama (min. 8 karakter). Hanya dipakai saat database masih kosong.
ADMIN_PASSWORD=
# String acak untuk mengamankan cron harian
CRON_SECRET=

# ===== AI chatbot (Claude) =====
ANTHROPIC_API_KEY=
# Opsional, default claude-opus-5-5
AI_MODEL=

# ===== Meta App (developers.facebook.com) =====
META_APP_ID=
META_APP_SECRET=
# Opsional: Configuration ID dari Facebook Login for Business
META_LOGIN_CONFIG_ID=
# Opsional, default v23.0
GRAPH_API_VERSION=

# ===== WhatsApp Cloud API =====
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
# Bebas, harus sama dengan "Verify token" di pengaturan webhook Meta
WHATSAPP_VERIFY_TOKEN=

# ===== Opsional: override Conversions API =====
META_DATASET_ID=
META_CAPI_TOKEN=
